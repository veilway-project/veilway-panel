{
	"name": "@veilway/panel-sdk",
	"version": "0.3.3",
	"description": "Typed client for the Veilway panel's admin API, for integrations that use an API token",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/veilway-project/veilway-panel.git",
		"directory": "sdk"
	},
	"homepage": "https://github.com/veilway-project/veilway-panel/tree/main/sdk",
	"keywords": ["veilway", "vpn", "panel", "api"],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist/src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"generate": "openapi-typescript ../server/openapi.json -o src/schema.ts",
		"check": "openapi-typescript ../server/openapi.json -o /tmp/veilway-panel-sdk-schema.ts && cmp src/schema.ts /tmp/veilway-panel-sdk-schema.ts && tsc --noEmit",
		"build": "tsc",
		"test": "tsc && node --test \"dist/test/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.9.3"
	}
}
